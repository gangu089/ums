<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Create Account</title>
</head>
<body>
      <form action="create">
       Id : <input type="number" name ="id" placeholder="Enter id here"><br><br>
       Name : <input type="text" name ="name" placeholder="Enter name here"><br><br>
       Email : <input type="text" name ="email" placeholder="Enter email here"><br><br>
       Phone : <input type="number" name ="phone" placeholder="Enter phonenum here"><br><br>
       Password : <input type="text" name ="password" placeholder="Enter password here"><br><br>
       <button>Submit</button>
      </form>
</body>
</html>